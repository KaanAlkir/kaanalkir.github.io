<style>
.talk-image-col {
  width: 120px;
  height: 120px;
  overflow: hidden;
  flex: 0 0 auto;
  margin-right: 1rem;
}
.talk-thumbnail {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 0.25rem;
}
.talk-title {
  font-weight: bold;
  color: var(--global-theme-color);
  margin-bottom: 0.5rem;
}
.publications-year {
  font-size: 2.5rem;
  font-weight: 700;
  color: var(--global-text-color);
  margin-top: 2.5rem;
  margin-bottom: 0.45rem;
}
.year-separator {
  border: none;
  border-bottom: 1px solid var(--global-text-color);
  margin: 0.5rem 0;
}
.abstract-text {
  font-size: 0.95rem;
  font-style: italic;
  margin-bottom: 0.5rem;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.abstract-text.expanded {
  -webkit-line-clamp: unset;
}
.read-more {
  background: none;
  border: none;
  color: var(--global-theme-color);
  cursor: pointer;
  padding: 0;
}
.talk-actions {
  display: flex;
  gap: 1rem;
  margin-top: 0.5rem;
  align-items: center;
}
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.read-more').forEach(button => {
      button.addEventListener('click', () => {
        const text = button.parentElement.previousElementSibling;
        text.classList.toggle('expanded');
        button.textContent = text.classList.contains('expanded') ? 'Read Less' : 'Read More';
      });
    });
  });
</script>

{% comment %} Sort talks globally by releaseDate descending, then group by year {% endcomment %}
{% assign sorted_talks = site.data.talks | sort: "releaseDate" | reverse %}
{% assign talks_by_year = sorted_talks | group_by_exp: "talk", "talk.releaseDate | date: '%Y'" %}

{% for group in talks_by_year | sort: "name" | reverse %}
  <div class="publications-year">{{ group.name }}</div>
  <hr class="year-separator">
  <ul class="card-text font-weight-light list-group list-group-flush talks-list">
    {% for talk in group.items %}
      {% assign formatted_date = talk.releaseDate | date: "%d %B" %}
      <li class="list-group-item" style="background: transparent!important; border: none!important;">
        <div class="d-flex align-items-start">
          <div class="talk-image-col">
            {% if talk.image %}
              <img src="{{ talk.image | relative_url }}" alt="{{ talk.title }}" class="talk-thumbnail">
            {% endif %}
          </div>
          <div class="flex-fill">
            <h6 class="talk-title">{{ talk.title }}</h6>
            {% if talk.venue %}
              <h6 style="font-size:0.95rem; margin:0.25rem 0;">
                {{ talk.venue }}
                <span class="text-muted" style="margin-left:0.5rem;font-size:0.85rem;">
                  {{ formatted_date }}
                </span>
              </h6>
            {% endif %}
            {% if talk.abstract %}
              <div class="abstract-text">{{ talk.abstract }}</div>
            {% endif %}
            {% if talk.abstract or talk.file %}
              <div class="talk-actions">
                {% if talk.abstract %}
                  <button class="read-more">Read More</button>
                {% endif %}
                {% if talk.file %}
                  <a href="{{ talk.file | relative_url }}" class="bib-button" title="Download PDF">
                    <i class="ti ti-file-text"></i> Resource
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      </li>
    {% endfor %}
  </ul>
{% endfor %}
